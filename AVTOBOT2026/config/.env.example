# Telegram API (https://my.telegram.org dan olinadi)
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# Bot token (@BotFather dan olinadi)
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Super admin Telegram ID
ADMIN_ID=123456789

# Bot username (referal havola uchun, @ belgisisiz)
BOT_USERNAME=avtoelon_el_uzbot

# Admin telefon raqami
ADMIN_CONTACT_PHONE=+998938670592

# Health server
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Worker limiti
MAX_CONCURRENT_WORKERS=50
MAX_CLIENT_POOL=50

# Yangi tasdiqlangan user uchun standart tarif
DEFAULT_DURATION_DAYS=30

# Tarif tugashini tekshirish oralig'i (soniya)
EXPIRY_CHECK_INTERVAL_S=60

# Serverdagi backup katalogi va saqlanadigan arxivlar soni
BACKUP_DIR=backups
BACKUP_RETENTION=7

# Ixtiyoriy: Fernet kaliti. Bo'sh qolsa data/.session.key avtomatik yaratiladi.
# SESSION_ENCRYPTION_KEY=
