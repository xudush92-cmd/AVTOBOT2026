# Telegram API (https://my.telegram.org dan olinadi)
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# Bot token (@BotFather dan olinadi)
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Super admin Telegram ID
ADMIN_ID=123456789

# Bot username (referal havola uchun, @ belgisisiz)
BOT_USERNAME=avtoelon_el_uzbot

# Admin telefon raqami
ADMIN_CONTACT_PHONE=+998938670592

# Health server
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Worker limiti
MAX_CONCURRENT_WORKERS=50
MAX_CLIENT_POOL=50

# Yangi tasdiqlangan user uchun standart tarif
DEFAULT_DURATION_DAYS=30

# Birinchi marta tasdiqlangan user uchun standart posting oralig'i (daqiqa).
# MIN_INTERVAL_MIN (5) va MAX_INTERVAL_MIN (10080) oralig'iga clamp qilinadi.
DEFAULT_INTERVAL_MIN=60

# Tarif tugashini tekshirish oralig'i (soniya)
EXPIRY_CHECK_INTERVAL_S=60

# Serverdagi backup katalogi va saqlanadigan arxivlar soni
BACKUP_DIR=backups
BACKUP_RETENTION=7

# Ixtiyoriy: Fernet kaliti. Bo'sh qolsa data/.session.key avtomatik yaratiladi.
# SESSION_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# MEDIA (ALBOM)
# ─────────────────────────────────────────────────────────────
# Bitta postda ruxsat etilgan media soni (Telegram albomi 10 tagacha).
MAX_ALBUM_FILES=10
# Bitta media fayl uchun maksimal hajm (bayt).
MAX_MEDIA_BYTES=20971520
# Albom yig'ish tugaguniga qadar kutish (soniya). Foydalanuvchi «✅ Tayyor»
# tugmasini bosmasa ham shundan keyin post saqlanadi.
ALBUM_DEBOUNCE_S=1.5
# Har bir foydalanuvchining media papkasida saqlanadigan fayllar soni.
MAX_MEDIA_FILES_PER_USER=200

# ─────────────────────────────────────────────────────────────
# YAGONA OYLIK OBUNA (cheklovlar yo'q)
# ─────────────────────────────────────────────────────────────
# Barcha foydalanuvchilar bir xil tarifda: guruh, post va kunlik yuborish cheksiz.
# Standart faol soatlar oynasi (bo'sh = kechasi ham yuboriladi).
ACTIVE_HOURS_DEFAULT=
# Yuborish jurnali va uning saqlash muddati (kun).
SEND_LOGS_ENABLED=1
SEND_LOG_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────
# REFERAL MUKOFOTI VA ANTI-FRAUD
# ─────────────────────────────────────────────────────────────
# Har bir FAOL referal uchun referrerga qo'shiladigan kun (0 = mukofot yo'q).
REFERRAL_BONUS_DAYS=3
# Oyda beriladigan maksimal bonus kun.
REFERRAL_BONUS_MONTHLY_CAP_DAYS=30
# Mukofot uchun referalning kamida muvaffaqiyatli yuborishlari soni.
REFERRAL_QUALIFY_MIN_SENDS=1
# Kuniga shunchadan ko'p referal qo'shilsa — adminga ogohlantirish.
REFERRAL_DAILY_ALERT=10

# ─────────────────────────────────────────────────────────────
# TEZ (AVTOMATIK) TASDIQLASH — standart holatda O'CHIRILGAN
# ─────────────────────────────────────────────────────────────
AUTO_APPROVE_ENABLED=0
# Shu ball yoki pastroq riskli arizalar avto-tasdiqlanadi.
AUTO_APPROVE_MAX_RISK=2
AUTO_APPROVE_CHECK_INTERVAL_S=60
AUTO_APPROVE_BATCH=5

# ─────────────────────────────────────────────────────────────
# TO'LOV — A REJA (qo'lda tasdiqlash + kvitansiya)
# ─────────────────────────────────────────────────────────────
# 0 = o'chirilgan (standart): 💳 tugmalari va navbat ko'rinmaydi, hech narsa o'zgarmaydi.
PAYMENTS_ENABLED=0
# Oylik obuna narxi (so'm). 0 yoki bo'sh = to'lov tugmasi ko'rinmaydi.
MONTHLY_PRICE=
# Karta rekvizitlari — mijoz kvitansiyani shu kartaga yuboradi
PAY_CARD=8600 0000 0000 0000
PAY_BANK=
PAY_HOLDER=
# Bir to'lov necha kunga uzaytiradi
PAYMENT_DAYS=30
# Kvitansiya yuborilmagan so'rov shundan keyin bekor (daqiqa)
PAYMENT_REQUEST_TTL_MIN=120
# Muddat tugashidan necha kun oldin bir marta eslatma
PAYMENT_REMIND_DAYS=3
# Qaror qilingan kvitansiya rasmi necha kun saqlanadi
PAYMENT_PROOF_RETENTION_DAYS=14
# Navbatda shuncha kvitansiya to'lsa adminga ogohlantirish
PAYMENT_QUEUE_ALERT=10
# Izoh kodi: AVTO-<uid>-<PAKET>
PAY_REF_PREFIX=AVTO
